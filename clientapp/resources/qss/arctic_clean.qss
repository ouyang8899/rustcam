@primary_bg: #f5f5f5;
@secondary_bg: #ffffff;
@tertiary_bg: #fafafa;
@accent: #0078D4;
@accent_hover: #1084d8;
@accent_pressed: #005a9e;
@text_primary: #1e1e1e;
@text_secondary: #6e6e6e;
@text_disabled: #999999;
@border: #e0e0e0;
@success: #4caf50;
@warning: #ff9800;
@error: #f44336;
@hover_bg: rgba(0, 0, 0, 0.04);
@selected_bg: rgba(0, 120, 212, 0.15);
@selected_bg_active: rgba(0, 120, 212, 0.25);

QMainWindow, QDialog {
    background-color: @primary_bg;
}

QWidget#centralArea {
    background-color: @secondary_bg;
}

QLabel, QPushButton {
    color: @text_primary;
}

QLabel#secondaryText {
    color: @text_secondary;
}

QPushButton {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 70px;
}

QPushButton:hover {
    background-color: @accent;
    border-color: @accent;
    color: white;
}

QPushButton:pressed {
    background-color: @accent_pressed;
    border-color: @accent_pressed;
}

QPushButton:disabled {
    background-color: @primary_bg;
    border-color: @border;
    color: @text_secondary;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: white;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px;
    color: @text_primary;
    selection-background-color: @accent;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: @accent;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: @primary_bg;
    color: @text_secondary;
}

QComboBox {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px 12px;
    color: @text_primary;
}

QComboBox:hover {
    border-color: @accent;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QMenuBar {
    background-color: @secondary_bg;
    border-bottom: 1px solid @border;
    color: @text_primary;
}

QMenuBar::item:selected {
    background-color: @accent;
    color: white;
}

QMenu {
    background-color: @secondary_bg;
    border: 1px solid @border;
    color: @text_primary;
}

QMenu::item:selected {
    background-color: @accent;
    color: white;
}

QToolBar {
    background-color: @secondary_bg;
    border: none;
    border-bottom: 1px solid @border;
    spacing: 8px;
    padding: 4px;
}

QToolBar::separator {
    background-color: @border;
    width: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: @secondary_bg;
    border-top: 1px solid @border;
    color: @text_secondary;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    color: @text_primary;
}

QToolButton:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

QToolButton:pressed {
    background-color: rgba(0, 0, 0, 0.08);
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
    margin: 2px 4px;
}

QToolButton#navIconButton:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

QToolButton#navIconButton:checked {
    background-color: rgba(0, 120, 212, 0.15);
}

QWidget#navIconBar {
    background-color: @secondary_bg;
    border-right: 1px solid @border;
}

QStackedWidget#navPanelStack {
    background-color: @secondary_bg;
    border-right: 1px solid @border;
}

QSplitter::handle {
    background-color: @border;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: @accent;
}

QLabel#navBadge {
    background-color: @error;
    color: white;
    font-size: 10px;
    font-weight: bold;
    border-radius: 8px;
    padding: 1px 5px;
    min-width: 16px;
    min-height: 16px;
}

QLabel#navStatusDot {
    background-color: @success;
    border-radius: 4px;
    min-width: 8px;
    min-height: 8px;
}

QLabel#statusOnline {
    color: @success;
}

QLabel#statusOffline {
    color: @error;
}

QLabel#statusWarning {
    color: @warning;
}

QWidget#workspaceArea {
    background-color: @secondary_bg;
}

QTabWidget::pane {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: @primary_bg;
    color: @text_secondary;
    padding: 8px 16px;
    border: 1px solid @border;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: @secondary_bg;
    color: @text_primary;
    border-color: @border;
    border-bottom: 1px solid @secondary_bg;
}

QTabBar::tab:hover {
    background-color: rgba(0, 0, 0, 0.04);
}

QScrollBar:vertical {
    background-color: @primary_bg;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #ccc;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #aaa;
}

QScrollBar:horizontal {
    background-color: @primary_bg;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #ccc;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #aaa;
}

QDockWidget {
    background-color: @secondary_bg;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background: @primary_bg;
    padding: 6px;
    border-bottom: 1px solid @border;
}

QTreeView {
    background-color: @secondary_bg;
    alternate-background-color: rgba(0, 0, 0, 0.02);
    border: 1px solid @border;
    color: @text_primary;
    gridline-color: @border;
    outline: 0;
    show-decoration-selected: 1;
}

QTreeView::item {
    color: @text_primary;
    padding: 6px 4px;
    border: 0px solid transparent;
    background-color: transparent;
}

QTreeView::item:hover {
    color: @text_primary;
    background-color: @hover_bg;
}

QTreeView::item:selected {
    color: #ffffff;
    background-color: @selected_bg;
}

QTreeView::item:selected:active {
    color: #ffffff;
    background-color: @selected_bg_active;
}

QTreeView::item:selected:!active {
    color: #ffffff;
    background-color: @selected_bg;
}

QTreeView::item:disabled {
    color: @text_disabled;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: none;
    border-image: none;
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: none;
    border-image: none;
}

QTreeView::branch {
    background-color: transparent;
}

QTreeView::branch:selected {
    background-color: @selected_bg;
}

QHeaderView::section {
    background-color: @primary_bg;
    color: @text_primary;
    padding: 8px;
    border: none;
    border-bottom: 1px solid @border;
    border-right: 1px solid @border;
}

QToolTip {
    background-color: @text_primary;
    color: white;
    border: 1px solid @border;
    padding: 4px;
    border-radius: 4px;
}

/* LoginWindow Styles */

rustcam--LoginWindow#loginTitle {
    color: @accent;
    font-size: 42px;
    font-weight: bold;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    letter-spacing: 4px;
}

rustcam--LoginWindow#loginSubtitle {
    color: rgba(0, 0, 0, 0.7);
    font-size: 14px;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    letter-spacing: 1px;
}

rustcam--LoginWindow#loginVersion {
    color: rgba(0, 0, 0, 0.3);
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
}

rustcam--LoginWindow#rightPanel {
    background-color: @secondary_bg;
}

rustcam--LoginWindow#welcomeLabel {
    color: @text_primary;
    font-size: 28px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
}

rustcam--LoginWindow#descLabel {
    color: @text_secondary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    margin-bottom: 20px;
}

rustcam--LoginWindow#formLabel {
    color: @text_secondary;
    font-size: 12px;
    font-family: 'Microsoft YaHei', sans-serif;
}

rustcam--LoginWindow#serverHostEdit,
rustcam--LoginWindow#usernameEdit,
rustcam--LoginWindow#passwordEdit {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 0 12px;
    color: @text_primary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    min-height: 40px;
}

rustcam--LoginWindow#serverHostEdit:focus,
rustcam--LoginWindow#usernameEdit:focus,
rustcam--LoginWindow#passwordEdit:focus {
    border-color: @accent;
}

rustcam--LoginWindow#serverHostEdit:disabled,
rustcam--LoginWindow#usernameEdit:disabled,
rustcam--LoginWindow#passwordEdit:disabled {
    background-color: @primary_bg;
    color: @text_secondary;
}

rustcam--LoginWindow#serverPortSpin {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 0 12px;
    color: @text_primary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    min-height: 40px;
}

rustcam--LoginWindow#serverPortSpin:focus {
    border-color: @accent;
}

rustcam--LoginWindow#serverPortSpin::up-button,
rustcam--LoginWindow#serverPortSpin::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

rustcam--LoginWindow#serverPortSpin::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid @text_secondary;
}

rustcam--LoginWindow#serverPortSpin::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid @text_secondary;
}

rustcam--LoginWindow#httpsCheck,
rustcam--LoginWindow#rememberCheck {
    color: @text_secondary;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
}

rustcam--LoginWindow#httpsCheck::indicator,
rustcam--LoginWindow#rememberCheck::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid @border;
    background-color: @secondary_bg;
}

rustcam--LoginWindow#httpsCheck::indicator:checked,
rustcam--LoginWindow#rememberCheck::indicator:checked {
    background-color: @accent;
    border-color: @accent;
}

rustcam--LoginWindow#httpsCheck:hover,
rustcam--LoginWindow#rememberCheck:hover {
    color: @text_primary;
}

rustcam--LoginWindow#errorLabel {
    color: @error;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
    background-color: rgba(244, 67, 54, 0.1);
    border: 1px solid rgba(244, 67, 54, 0.3);
    border-radius: 4px;
    padding: 8px 12px;
}

rustcam--LoginWindow#loginButton {
    background-color: @accent;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
    letter-spacing: 8px;
    min-height: 50px;
}

rustcam--LoginWindow#loginButton:hover {
    background-color: @accent_hover;
}

rustcam--LoginWindow#loginButton:pressed {
    background-color: @accent_pressed;
}

rustcam--LoginWindow#loginButton:disabled {
    background-color: @border;
    color: @text_secondary;
}

rustcam--LoginWindow#forgotLabel,
rustcam--LoginWindow#serverConfigLink {
    color: @text_secondary;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
}

rustcam--LoginWindow#forgotLabel a,
rustcam--LoginWindow#serverConfigLink a {
    color: @text_secondary;
    text-decoration: none;
}

rustcam--LoginWindow#forgotLabel a:hover,
rustcam--LoginWindow#serverConfigLink a:hover {
    color: @accent;
}

rustcam--LoginWindow#copyrightLabel {
    color: @text_secondary;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
}
