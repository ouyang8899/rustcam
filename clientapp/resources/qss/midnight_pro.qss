@primary_bg: #1e1e1e;
@secondary_bg: #2b2b2b;
@tertiary_bg: #1a1a1a;
@accent: #0078D4;
@accent_hover: #1084d8;
@accent_pressed: #005a9e;
@text_primary: #e0e0e0;
@text_secondary: #9e9e9e;
@text_disabled: #666666;
@border: #3e3e3e;
@success: #4caf50;
@warning: #ff9800;
@error: #f44336;
@hover_bg: rgba(255, 255, 255, 0.08);
@selected_bg: rgba(0, 120, 212, 0.3);
@selected_bg_active: rgba(0, 120, 212, 0.5);
@video_area_bg: #2a2a2a;

QMainWindow, QDialog, QWidget {
    background-color: @primary_bg;
}

QWidget#centralArea {
    background-color: @secondary_bg;
}

QLabel, QPushButton {
    color: @text_primary;
}

QLabel#secondaryText {
    color: @text_secondary;
}

QPushButton {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 70px;
}

QPushButton:hover {
    background-color: @accent;
    border-color: @accent;
}

QPushButton:pressed {
    background-color: @accent_pressed;
    border-color: @accent_pressed;
}

QPushButton:disabled {
    background-color: @secondary_bg;
    border-color: @border;
    color: @text_secondary;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1a1a1a;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px;
    color: @text_primary;
    selection-background-color: @accent;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: @accent;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #151515;
    color: @text_secondary;
}

QComboBox {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px 12px;
    color: @text_primary;
}

QComboBox:hover {
    border-color: @accent;
}

QComboBox#themeCombo {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 24px 4px 8px;
    color: @text_primary;
    min-width: 120px;
}

QComboBox#themeCombo::drop-down {
    border: none;
    width: 20px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
}

QComboBox#themeCombo QAbstractItemView {
    background-color: @secondary_bg;
    border: 1px solid @border;
    color: @text_primary;
    selection-background-color: @accent;
    show-decoration-selected: true;
    min-height: 80px;
}

QMenuBar {
    background-color: @primary_bg;
    border-bottom: 1px solid @border;
    color: @text_primary;
}

QMenuBar::item:selected {
    background-color: @accent;
}

QMenu {
    background-color: @secondary_bg;
    border: 1px solid @border;
    color: @text_primary;
}

QMenu::item:selected {
    background-color: @accent;
}

QToolBar {
    background-color: @primary_bg;
    border: none;
    spacing: 8px;
    padding: 4px;
}

QToolBar::separator {
    background-color: @border;
    width: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: @primary_bg;
    border-top: 1px solid @border;
    color: @text_secondary;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    color: @text_primary;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
    margin: 2px 4px;
}

QToolButton#navIconButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QToolButton#navIconButton:checked {
    background-color: rgba(0, 120, 212, 0.20);
}

QWidget#PTZControlPanel QToolButton:hover {
    background-color: rgba(0, 120, 212, 0.25);
}

QWidget#PTZControlPanel QToolButton:pressed {
    background-color: rgba(0, 120, 212, 0.35);
}

QToolButton#btnCenter:hover {
    background-color: rgba(0, 120, 212, 0.25);
}

QLabel#userLabel {
    color: @text_primary;
    padding: 0 8px;
}

QWidget#navIconBar {
    background-color: #1a1a1a;
    border-right: 1px solid @border;
}

QStackedWidget#navPanelStack {
    background-color: @secondary_bg;
    border-right: 1px solid @border;
}

QSplitter::handle {
    background-color: @border;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: @accent;
}

QLabel#navBadge {
    background-color: @error;
    color: white;
    font-size: 10px;
    font-weight: bold;
    border-radius: 8px;
    padding: 1px 5px;
    min-width: 16px;
    min-height: 16px;
}

QLabel#navStatusDot {
    background-color: @success;
    border-radius: 4px;
    min-width: 8px;
    min-height: 8px;
}

QLabel#statusOnline {
    color: @success;
}

QLabel#statusOffline {
    color: @error;
}

QLabel#statusWarning {
    color: @warning;
}

QWidget#workspaceArea {
    background-color: @secondary_bg;
}

QTabWidget::pane {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: @primary_bg;
    color: @text_secondary;
    padding: 8px 16px;
    border: 1px solid @border;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: @secondary_bg;
    color: @text_primary;
    border-color: @border;
    border-bottom: 1px solid @secondary_bg;
}

QTabBar::tab:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

QScrollBar:vertical {
    background-color: @primary_bg;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: @border;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: @primary_bg;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: @border;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #555;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QDockWidget {
    background-color: @secondary_bg;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background: @primary_bg;
    padding: 6px;
    border-bottom: 1px solid @border;
}

QTreeView {
    background-color: @tertiary_bg;
    alternate-background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid @border;
    color: @text_primary;
    gridline-color: @border;
    outline: 0;
    /* branch 缩进背景由 DeviceTreeView::drawBranches 绘制，避免系统高亮盖住 */
    show-decoration-selected: 0;
}

QTreeView::item {
    padding: 4px;
}

QTreeView::item:selected {
    color: @text_primary;
}

QTreeView::item:selected:!active {
    color: @text_primary;
}

QHeaderView::section {
    background-color: @primary_bg;
    color: @text_primary;
    padding: 8px;
    border: none;
    border-bottom: 1px solid @border;
    border-right: 1px solid @border;
}

QTableView {
    background-color: @tertiary_bg;
    alternate-background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid @border;
    border-radius: 4px;
    color: @text_primary;
    gridline-color: @border;
    outline: 0;
}

QTableView::item {
    padding: 4px 6px;
}

QTableView::item:hover {
    background-color: @hover_bg;
}

QTableView::item:selected,
QTableView::item:selected:!active {
    background-color: @selected_bg;
    color: @text_primary;
}

QFrame#cardFrame {
    background-color: @tertiary_bg;
    border: 1px solid @border;
    border-radius: 4px;
}

QLabel#sectionTitle {
    color: @text_primary;
    font-size: 14px;
    font-weight: bold;
    padding: 0 8px;
}

QLabel#alarmCount {
    color: @error;
    font-size: 12px;
    padding: 0 8px;
}

QPushButton#primaryButton {
    background-color: @accent;
    color: white;
    border: 1px solid @accent;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 70px;
}

QPushButton#primaryButton:hover {
    background-color: @accent_hover;
    border-color: @accent_hover;
}

QPushButton#primaryButton:pressed {
    background-color: @accent_pressed;
    border-color: @accent_pressed;
}

QPushButton#primaryButton:disabled {
    background-color: @secondary_bg;
    border-color: @border;
    color: @text_disabled;
}

QToolTip {

    background-color: @primary_bg;
    color: @text_primary;
    border: 1px solid @border;
    padding: 4px;
    border-radius: 4px;
}

/* LoginWindow Styles */

rustcam--LoginWindow#loginTitle {
    color: @accent;
    font-size: 42px;
    font-weight: bold;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    letter-spacing: 4px;
}

rustcam--LoginWindow#loginSubtitle {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    letter-spacing: 1px;
}

rustcam--LoginWindow#loginVersion {
    color: rgba(255, 255, 255, 0.3);
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
}

rustcam--LoginWindow#rightPanel {
    background-color: @primary_bg;
}

rustcam--LoginWindow#welcomeLabel {
    color: @text_primary;
    font-size: 28px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
}

rustcam--LoginWindow#descLabel {
    color: @text_secondary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    margin-bottom: 20px;
}

rustcam--LoginWindow#formLabel {
    color: @text_secondary;
    font-size: 12px;
    font-family: 'Microsoft YaHei', sans-serif;
}

rustcam--LoginWindow#serverHostEdit,
rustcam--LoginWindow#usernameEdit,
rustcam--LoginWindow#passwordEdit {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 0 12px;
    color: @text_primary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    min-height: 40px;
}

rustcam--LoginWindow#serverHostEdit:focus,
rustcam--LoginWindow#usernameEdit:focus,
rustcam--LoginWindow#passwordEdit:focus {
    border-color: @accent;
    background-color: @primary_bg;
}

rustcam--LoginWindow#serverHostEdit:disabled,
rustcam--LoginWindow#usernameEdit:disabled,
rustcam--LoginWindow#passwordEdit:disabled {
    background-color: @primary_bg;
    color: @text_secondary;
}

rustcam--LoginWindow#serverPortSpin {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 0 12px;
    color: @text_primary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    min-height: 40px;
}

rustcam--LoginWindow#serverPortSpin:focus {
    border-color: @accent;
    background-color: @primary_bg;
}

rustcam--LoginWindow#serverPortSpin::up-button,
rustcam--LoginWindow#serverPortSpin::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

rustcam--LoginWindow#serverPortSpin::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid @text_secondary;
}

rustcam--LoginWindow#serverPortSpin::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid @text_secondary;
}

rustcam--LoginWindow#httpsCheck,
rustcam--LoginWindow#rememberCheck {
    color: @text_secondary;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
}

rustcam--LoginWindow#httpsCheck::indicator,
rustcam--LoginWindow#rememberCheck::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid @border;
    background-color: @secondary_bg;
}

rustcam--LoginWindow#httpsCheck::indicator:checked,
rustcam--LoginWindow#rememberCheck::indicator:checked {
    background-color: @accent;
    border-color: @accent;
}

rustcam--LoginWindow#httpsCheck:hover,
rustcam--LoginWindow#rememberCheck:hover {
    color: @text_primary;
}

rustcam--LoginWindow#errorLabel {
    color: @error;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
    background-color: rgba(244, 67, 54, 0.1);
    border: 1px solid rgba(244, 67, 54, 0.3);
    border-radius: 4px;
    padding: 8px 12px;
}

rustcam--LoginWindow#loginButton {
    background-color: @accent;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
    letter-spacing: 8px;
    min-height: 50px;
}

rustcam--LoginWindow#loginButton:hover {
    background-color: @accent_hover;
}

rustcam--LoginWindow#loginButton:pressed {
    background-color: @accent_pressed;
}

rustcam--LoginWindow#loginButton:disabled {
    background-color: @border;
    color: @text_secondary;
}

QLabel#forgotLabel,
QLabel#serverConfigLink {
    color: @text_secondary;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
}

QLabel#forgotLabel a,
QLabel#serverConfigLink a {
    color: @text_secondary;
    text-decoration: none;
}

QLabel#forgotLabel a:hover,
QLabel#serverConfigLink a:hover {
    color: @accent;
}

rustcam--LoginWindow#copyrightLabel {
    color: @text_secondary;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
}

/* LiveVideo Styles */
VideoCell {
    background-color: #000000;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

VideoCell:hover {
    border: 1px solid @accent;
}

VideoLabel {
    color: #666;
    font-size: 14px;
    background-color: #000;
}

VideoOverlay {
    background-color: rgba(0, 0, 0, 0.7);
}

VideoOverlay #OverlayText {
    color: #666;
    font-size: 12px;
}

OsdLabel {
    color: white;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 4px 8px;
    border-radius: 2px;
    font-size: 11px;
}

TitleLabel {
    color: white;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 4px 8px;
    border-radius: 2px;
    font-size: 12px;
    font-weight: bold;
}

QToolBar#VideoToolbar {
    background-color: @primary_bg;
    border: none;
    spacing: 8px;
    padding: 4px;
}

QToolBar#VideoToolbar QLabel {
    color: @text_primary;
}

QToolBar#VideoToolbar QComboBox {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 8px;
    color: @text_primary;
}

#VideoPlayer {
    border: none;
    background-color: #1a1a1a;
}


#VideoPlayer #NoSignalIcon{
    background-color: transparent;
}

#VideoPlayerToolbar {
    background-color: rgba(0, 0, 0, 180);
}

#VideoPlayerToolbar #ToolbarButton {
    background-color: transparent;
    border: none;
    padding: 4px;
    color: @text_primary;
}

#VideoPlayerToolbar #ToolbarButton:hover {
    background-color: @hover_bg;
    border-radius: 4px;
}

#VideoPlayerToolbar #ToolbarButton:pressed {
    background-color: @accent_pressed;
    border-radius: 4px;
}

#VideoPlayerToolbar #ToolbarButton:checked {
    background-color: @accent;
    border-radius: 4px;
}

#VideoPlayerToolbar #VideoPlayerToolbarWidget {
    background-color: transparent;
}
#videoArea {
    background-color: @video_area_bg;
}

LayoutNavButton {
    border: 1px solid @border;
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #333, stop:1 #222);
}

LayoutNavButton:hover {
    border: 1px solid #888;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #444, stop:1 #333);
}

LayoutNavButton:pressed {
    border: 1px solid @accent;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @accent, stop:1 @accent_pressed);
}

#navBar {
    background-color: @secondary_bg;
}

/* Settings Widget Styles */
QTabWidget#settingsTabs::pane {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 16px;
}

QTabWidget#settingsTabs QTabBar::tab {
    background-color: @primary_bg;
    color: @text_secondary;
    padding: 10px 20px;
    border: 1px solid @border;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
}

QTabWidget#settingsTabs QTabBar::tab:selected {
    background-color: @secondary_bg;
    color: @text_primary;
    border-color: @border;
    border-bottom: 1px solid @secondary_bg;
}

QTabWidget#settingsTabs QTabBar::tab:hover {
    background-color: @hover_bg;
}

QCheckBox {
    color: @text_primary;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid @border;
    background-color: @primary_bg;
}

QCheckBox::indicator:checked {
    background-color: @accent;
    border-color: @accent;
    image: url(:/icons/check.svg);
}

QCheckBox::indicator:unchecked:hover {
    border-color: @accent;
}

QSpinBox {
    background-color: @primary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px;
    color: @text_primary;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
}

QSpinBox:focus {
    border-color: @accent;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: @secondary_bg;
    border: none;
    width: 20px;
    border-radius: 2px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: @accent;
}

QSpinBox::up-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid @text_primary;
}

QSpinBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid @text_primary;
}

QListWidget {
    background-color: @primary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    color: @text_primary;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    padding: 4px;
}

QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
    background-color: transparent;
}

QListWidget::item:hover {
    background-color: @hover_bg;
}

QListWidget::item:selected {
    background-color: @selected_bg;
    color: @text_primary;
}

QGroupBox {
    border: 1px solid @border;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 12px;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    color: @text_primary;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    color: @text_primary;
}

#colorPreviewLabel {
    border: 1px solid @border;
    border-radius: 4px;
    min-width: 60px;
    min-height: 24px;
    background-color: @primary_bg;
}

SettingsWidget QLabel {
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
}

/* ── Playback / Recording ──────────────────────────────────────── */

#playbackWorkspace,
#playbackRightPanel,
#PlaybackSidePanel {
    background-color: @primary_bg;
}

#playbackWorkspace QLabel {
    color: @text_primary;
}

#playbackToolbar {
    background-color: @primary_bg;
    border: none;
    border-bottom: 1px solid @border;
    spacing: 8px;
    padding: 4px;
}

QLabel#PlaybackSectionTitle {
    color: @text_primary;
    font-weight: bold;
    padding: 4px;
}

QLabel#PlaybackPanelLabel {
    color: @text_primary;
}

QLabel#PlaybackTargetLabel {
    color: @text_secondary;
}

QLabel#currentTimeLabel {
    color: @text_primary;
    font-family: monospace;
    min-width: 150px;
}

#PlaybackFilterFrame,
#PlaybackFileListFrame {
    border: 1px solid @border;
    border-radius: 4px;
}

#PlaybackFilterScroll {
    background-color: @primary_bg;
    border: none;
}

#PlaybackFilterScroll > QWidget > QWidget {
    background-color: @primary_bg;
}

QDateEdit#PlaybackFilterInput,
QDateTimeEdit#PlaybackFilterInput {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px;
    color: @text_primary;
}

QDateEdit#PlaybackFilterInput:focus,
QDateTimeEdit#PlaybackFilterInput:focus {
    border-color: @accent;
}

QDateTimeEdit#PlaybackFilterInput {
    font-size: 11px;
}

QLabel#PlaybackFilterFieldLabel {
    color: @text_secondary;
}

QLabel#PlaybackStatusLabel {
    color: @text_secondary;
    font-size: 11px;
    padding: 0 4px;
}

QPushButton#LoadMoreButton {
    background-color: @secondary_bg;
    color: @text_primary;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px;
}

QPushButton#LoadMoreButton:hover {
    background-color: @hover_bg;
}

QPushButton#LoadMoreButton:disabled {
    color: @text_disabled;
}

QListWidget#PlaybackBookmarkList {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    color: @text_primary;
    font-size: 12px;
}

QListWidget#PlaybackBookmarkList::item:selected {
    background-color: @selected_bg_active;
    color: @text_primary;
}

QLabel#RecordingCountLabel {
    color: @text_secondary;
    font-size: 12px;
    padding: 2px;
}

QComboBox#RecordingPageSizeCombo {
    font-size: 12px;
}

#RecordingFileListView {
    background-color: @secondary_bg;
    border: none;
    outline: none;
}

#RecordingFileListView::item {
    padding: 4px;
    border-bottom: 1px solid @border;
    color: @text_primary;
}

#RecordingFileListView::item:hover {
    background-color: @hover_bg;
}

#RecordingFileListView::item:selected {
    background-color: @selected_bg;
    color: @text_primary;
}

#TimelineWidget {
    background-color: @tertiary_bg;
    border: 1px solid @border;
}

#PlaybackCell {
    border: 2px solid @video_area_bg;
    background-color: @video_area_bg;
}

#PlaybackCell[selected="true"] {
    border-color: @accent;
}
#NoRecordingLabel {
    color: #e0e0e0;
    font-size: 14px;
    background-color: rgba(0, 0, 0, 180);
    border-radius: 4px;
    padding: 8px 16px;
}
/* 日期选择下拉日历 */
QCalendarWidget {
    background-color: @secondary_bg;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: @primary_bg;
    border-bottom: 1px solid @border;
}

QCalendarWidget QToolButton {
    color: @text_primary;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: @hover_bg;
}


QCalendarWidget QMenu {
    background-color: @secondary_bg;
    color: @text_primary;
    border: 1px solid @border;
}

QCalendarWidget QMenu::item:selected {
    background-color: @accent;
    color: #ffffff;
}

QCalendarWidget QSpinBox {
    background-color: @secondary_bg;
    color: @text_primary;
    border: 1px solid @border;
    selection-background-color: @accent;
    selection-color: #ffffff;
}

QCalendarWidget QAbstractItemView {
    background-color: @secondary_bg;
    color: @text_primary;
    selection-background-color: @accent;
    selection-color: #ffffff;
    outline: none;
}

QCalendarWidget QHeaderView::section {
    background-color: @primary_bg;
    color: @text_secondary;
    padding: 2px;
    border: none;
}
