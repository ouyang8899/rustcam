@primary_bg: #1e1e1e;
@secondary_bg: #2b2b2b;
@accent: #0078D4;
@accent_hover: #1084d8;
@accent_pressed: #005a9e;
@text_primary: #e0e0e0;
@text_secondary: #9e9e9e;
@border: #3e3e3e;
@success: #4caf50;
@warning: #ff9800;
@error: #f44336;

QMainWindow, QDialog, QWidget {
    background-color: @primary_bg;
}

QWidget#centralArea {
    background-color: @secondary_bg;
}

QLabel, QPushButton {
    color: @text_primary;
}

QLabel#secondaryText {
    color: @text_secondary;
}

QPushButton {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 70px;
}

QPushButton:hover {
    background-color: @accent;
    border-color: @accent;
}

QPushButton:pressed {
    background-color: @accent_pressed;
    border-color: @accent_pressed;
}

QPushButton:disabled {
    background-color: @secondary_bg;
    border-color: @border;
    color: @text_secondary;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1a1a1a;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px;
    color: @text_primary;
    selection-background-color: @accent;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: @accent;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #151515;
    color: @text_secondary;
}

QComboBox {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px 12px;
    color: @text_primary;
}

QComboBox:hover {
    border-color: @accent;
}

QMenuBar {
    background-color: @primary_bg;
    border-bottom: 1px solid @border;
    color: @text_primary;
}

QMenuBar::item:selected {
    background-color: @accent;
}

QMenu {
    background-color: @secondary_bg;
    border: 1px solid @border;
    color: @text_primary;
}

QMenu::item:selected {
    background-color: @accent;
}

QToolBar {
    background-color: @primary_bg;
    border: none;
    spacing: 8px;
    padding: 4px;
}

QToolBar::separator {
    background-color: @border;
    width: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: @primary_bg;
    border-top: 1px solid @border;
    color: @text_secondary;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    color: @text_primary;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
    margin: 2px 4px;
}

QToolButton#navIconButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QToolButton#navIconButton:checked {
    background-color: rgba(0, 120, 212, 0.20);
}

QWidget#navIconBar {
    background-color: #1a1a1a;
    border-right: 1px solid @border;
}

QStackedWidget#navPanelStack {
    background-color: @secondary_bg;
    border-right: 1px solid @border;
}

QSplitter::handle {
    background-color: @border;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: @accent;
}

QLabel#navBadge {
    background-color: @error;
    color: white;
    font-size: 10px;
    font-weight: bold;
    border-radius: 8px;
    padding: 1px 5px;
    min-width: 16px;
    min-height: 16px;
}

QLabel#navStatusDot {
    background-color: @success;
    border-radius: 4px;
    min-width: 8px;
    min-height: 8px;
}

QLabel#statusOnline {
    color: @success;
}

QLabel#statusOffline {
    color: @error;
}

QLabel#statusWarning {
    color: @warning;
}

QWidget#workspaceArea {
    background-color: @secondary_bg;
}

QTabWidget::pane {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: @primary_bg;
    color: @text_secondary;
    padding: 8px 16px;
    border: 1px solid @border;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: @secondary_bg;
    color: @text_primary;
    border-color: @border;
    border-bottom: 1px solid @secondary_bg;
}

QTabBar::tab:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

QScrollBar:vertical {
    background-color: @primary_bg;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: @border;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: @primary_bg;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: @border;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #555;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QDockWidget {
    background-color: @secondary_bg;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background: @primary_bg;
    padding: 6px;
    border-bottom: 1px solid @border;
}

QTreeWidget, QListWidget, QTableWidget {
    background-color: #1a1a1a;
    alternate-background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid @border;
    color: @text_primary;
    gridline-color: @border;
}

QTreeWidget::item:selected, QListWidget::item:selected, QTableWidget::item:selected {
    background-color: rgba(0, 120, 212, 0.3);
}

QTreeWidget::item:hover, QListWidget::item:hover, QTableWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

QHeaderView::section {
    background-color: @primary_bg;
    color: @text_primary;
    padding: 8px;
    border: none;
    border-bottom: 1px solid @border;
    border-right: 1px solid @border;
}

QToolTip {
    background-color: @primary_bg;
    color: @text_primary;
    border: 1px solid @border;
    padding: 4px;
    border-radius: 4px;
}

/* LoginWindow Styles */

rustcam--LoginWindow#loginTitle {
    color: @accent;
    font-size: 42px;
    font-weight: bold;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    letter-spacing: 4px;
}

rustcam--LoginWindow#loginSubtitle {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    letter-spacing: 1px;
}

rustcam--LoginWindow#loginVersion {
    color: rgba(255, 255, 255, 0.3);
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
}

rustcam--LoginWindow#rightPanel {
    background-color: @primary_bg;
}

rustcam--LoginWindow#welcomeLabel {
    color: @text_primary;
    font-size: 28px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
}

rustcam--LoginWindow#descLabel {
    color: @text_secondary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    margin-bottom: 20px;
}

rustcam--LoginWindow#formLabel {
    color: @text_secondary;
    font-size: 12px;
    font-family: 'Microsoft YaHei', sans-serif;
}

rustcam--LoginWindow#serverHostEdit,
rustcam--LoginWindow#usernameEdit,
rustcam--LoginWindow#passwordEdit {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 0 12px;
    color: @text_primary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    min-height: 40px;
}

rustcam--LoginWindow#serverHostEdit:focus,
rustcam--LoginWindow#usernameEdit:focus,
rustcam--LoginWindow#passwordEdit:focus {
    border-color: @accent;
    background-color: @primary_bg;
}

rustcam--LoginWindow#serverHostEdit:disabled,
rustcam--LoginWindow#usernameEdit:disabled,
rustcam--LoginWindow#passwordEdit:disabled {
    background-color: @primary_bg;
    color: @text_secondary;
}

rustcam--LoginWindow#serverPortSpin {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 0 12px;
    color: @text_primary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    min-height: 40px;
}

rustcam--LoginWindow#serverPortSpin:focus {
    border-color: @accent;
    background-color: @primary_bg;
}

rustcam--LoginWindow#serverPortSpin::up-button,
rustcam--LoginWindow#serverPortSpin::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

rustcam--LoginWindow#serverPortSpin::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid @text_secondary;
}

rustcam--LoginWindow#serverPortSpin::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid @text_secondary;
}

rustcam--LoginWindow#httpsCheck,
rustcam--LoginWindow#rememberCheck {
    color: @text_secondary;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
}

rustcam--LoginWindow#httpsCheck::indicator,
rustcam--LoginWindow#rememberCheck::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid @border;
    background-color: @secondary_bg;
}

rustcam--LoginWindow#httpsCheck::indicator:checked,
rustcam--LoginWindow#rememberCheck::indicator:checked {
    background-color: @accent;
    border-color: @accent;
}

rustcam--LoginWindow#httpsCheck:hover,
rustcam--LoginWindow#rememberCheck:hover {
    color: @text_primary;
}

rustcam--LoginWindow#errorLabel {
    color: @error;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
    background-color: rgba(244, 67, 54, 0.1);
    border: 1px solid rgba(244, 67, 54, 0.3);
    border-radius: 4px;
    padding: 8px 12px;
}

rustcam--LoginWindow#loginButton {
    background-color: @accent;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
    letter-spacing: 8px;
    min-height: 50px;
}

rustcam--LoginWindow#loginButton:hover {
    background-color: @accent_hover;
}

rustcam--LoginWindow#loginButton:pressed {
    background-color: @accent_pressed;
}

rustcam--LoginWindow#loginButton:disabled {
    background-color: @border;
    color: @text_secondary;
}

QLabel#forgotLabel,
QLabel#serverConfigLink {
    color: @text_secondary;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
}

QLabel#forgotLabel a,
QLabel#serverConfigLink a {
    color: @text_secondary;
    text-decoration: none;
}

QLabel#forgotLabel a:hover,
QLabel#serverConfigLink a:hover {
    color: @accent;
}

rustcam--LoginWindow#copyrightLabel {
    color: @text_secondary;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
}
