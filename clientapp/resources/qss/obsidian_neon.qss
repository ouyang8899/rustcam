/* ── 主题 token ──────────────────────────────────────────────────────
 * 三个主题文件（midnight_pro / arctic_clean / obsidian_neon）结构完全一致，
 * 唯一的差别就是下面这张表。增删 token 必须同步三份文件。
 */
@primary_bg: #1a1a2e;
@secondary_bg: #16213e;
@tertiary_bg: #0f172a;
@accent: #7c3aed;
@accent_hover: #9333ea;
@accent_pressed: #6b21a8;
@text_primary: #e2e8f0;
@text_secondary: #94a3b8;
@text_disabled: #64748b;
@border: #334155;
@success: #10b981;
@warning: #f59e0b;
@error: #ef4444;
@info: #22d3ee;
@on_accent: #ffffff;
@hover_bg: rgba(124, 58, 237, 0.15);
@pressed_bg: rgba(124, 58, 237, 0.30);
@selected_bg: rgba(124, 58, 237, 0.30);
@selected_bg_active: rgba(124, 58, 237, 0.50);
@panel_alt: rgba(124, 58, 237, 0.05);
@video_area_bg: #16213e;

/* 视频浮层：始终压在画面上，底色恒为深色，三套主题取值一致 */
@overlay_bg: rgba(0, 0, 0, 180);
@overlay_text: #e0e0e0;
@overlay_hover: rgba(255, 255, 255, 0.10);
@overlay_pressed: rgba(255, 255, 255, 0.20);

/* 实时视频格子 */
@cell_bg: #0f172a;
@cell_border: rgba(124, 58, 237, 0.20);
@cell_fg: #64748b;
@osd_bg: rgba(124, 58, 237, 0.60);

/* 布局切换按钮（class 属性为 LayoutNavButton） */
@navbtn_bg1: #2a2a44;
@navbtn_bg2: #1e1e38;
@navbtn_hover1: #3a3a55;
@navbtn_hover2: #2a2a44;
@navbtn_border: #334155;

/* 滚动条 / 错误提示 */
@scrollbar_hover: #7c3aed;
@error_soft_bg: rgba(239, 68, 68, 0.10);
@error_soft_border: rgba(239, 68, 68, 0.30);
@error_overlay_bg: rgba(180, 50, 50, 200);

QMainWindow, QDialog, QWidget {
    background-color: @primary_bg;
}

QWidget#centralArea {
    background-color: @secondary_bg;
}

QLabel, QPushButton {
    color: @text_primary;
}

/* 标签不画底色，避免在面板上留下与父容器不一致的色块 */
QLabel {
    background-color: transparent;
}

QLabel#secondaryText {
    color: @text_secondary;
}

QPushButton {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 70px;
}

QPushButton:hover {
    background-color: @accent;
    border-color: @accent;
    color: @on_accent;
}

QPushButton:pressed {
    background-color: @accent_pressed;
    border-color: @accent_pressed;
}

QPushButton:disabled {
    background-color: @secondary_bg;
    border-color: @border;
    color: @text_secondary;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: @tertiary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px;
    color: @text_primary;
    selection-background-color: @accent;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: @accent;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: @primary_bg;
    color: @text_secondary;
}

QComboBox {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px 12px;
    color: @text_primary;
}

QComboBox:hover {
    border-color: @accent;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox#themeCombo {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 24px 4px 8px;
    color: @text_primary;
    min-width: 120px;
}

QComboBox#themeCombo::drop-down {
    border: none;
    width: 20px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
}

QComboBox#themeCombo QAbstractItemView {
    background-color: @secondary_bg;
    border: 1px solid @border;
    color: @text_primary;
    selection-background-color: @accent;
    show-decoration-selected: true;
    min-height: 80px;
}

QMenuBar {
    background-color: @primary_bg;
    border-bottom: 1px solid @border;
    color: @text_primary;
}

QMenuBar::item:selected {
    background-color: @accent;
    color: @on_accent;
}

QMenu {
    background-color: @secondary_bg;
    border: 1px solid @border;
    color: @text_primary;
}

QMenu::item:selected {
    background-color: @accent;
    color: @on_accent;
}

QToolBar {
    background-color: @primary_bg;
    border: none;
    spacing: 8px;
    padding: 4px;
}

QToolBar::separator {
    background-color: @border;
    width: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: @primary_bg;
    border-top: 1px solid @border;
    color: @text_secondary;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    color: @text_primary;
}

QToolButton:hover {
    background-color: @hover_bg;
}

QToolButton:pressed {
    background-color: @pressed_bg;
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
    margin: 2px 4px;
}

QToolButton#navIconButton:hover {
    background-color: @hover_bg;
}

QToolButton#navIconButton:checked {
    background-color: @selected_bg;
}

QWidget#PTZControlPanel QToolButton:hover {
    background-color: @selected_bg;
}

QWidget#PTZControlPanel QToolButton:pressed {
    background-color: @selected_bg_active;
}

/* 必须比 QWidget#PTZControlPanel QToolButton:hover 更具体，否则会被它压掉 */
QWidget#PTZControlPanel QToolButton#btnCenter:hover {
    background-color: @selected_bg;
}

QLabel#userLabel {
    color: @text_primary;
    padding: 0 8px;
}

QWidget#navIconBar {
    background-color: @tertiary_bg;
    border-right: 1px solid @border;
}

QStackedWidget#navPanelStack {
    background-color: @secondary_bg;
    border-right: 1px solid @border;
}

QSplitter::handle {
    background-color: @border;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: @accent;
}

QLabel#navBadge {
    background-color: @error;
    color: @on_accent;
    font-size: 10px;
    font-weight: bold;
    border-radius: 8px;
    padding: 1px 5px;
    min-width: 16px;
    min-height: 16px;
}

QLabel#navStatusDot {
    background-color: @success;
    border-radius: 4px;
    min-width: 8px;
    min-height: 8px;
}

QLabel#statusOnline {
    color: @success;
}

QLabel#statusOffline {
    color: @error;
}

QLabel#statusWarning {
    color: @warning;
}

QWidget#workspaceArea {
    background-color: @secondary_bg;
}

QTabWidget::pane {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: @primary_bg;
    color: @text_secondary;
    padding: 8px 16px;
    border: 1px solid @border;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: @secondary_bg;
    color: @text_primary;
    border-color: @border;
    border-bottom: 1px solid @secondary_bg;
}

QTabBar::tab:hover {
    background-color: @hover_bg;
}

QScrollBar:vertical {
    background-color: @primary_bg;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: @border;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: @scrollbar_hover;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: @primary_bg;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: @border;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @scrollbar_hover;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QDockWidget {
    background-color: @secondary_bg;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background: @primary_bg;
    padding: 6px;
    border-bottom: 1px solid @border;
}

QTreeView {
    background-color: @tertiary_bg;
    alternate-background-color: @panel_alt;
    border: 1px solid @border;
    color: @text_primary;
    gridline-color: @border;
    outline: 0;
    /* branch 缩进背景由 DeviceTreeView::drawBranches 绘制，避免系统高亮盖住 */
    show-decoration-selected: 0;
}

QTreeView::item {
    color: @text_primary;
    padding: 6px 4px;
    border: 0px solid transparent;
    background-color: transparent;
}

QTreeView::item:hover {
    color: @text_primary;
    background-color: @hover_bg;
}

/* 选中底色由 FullRowSelectDelegate 与 DeviceTreeView::drawBranches 绘制，
   这里不能再设 background-color，否则半透明色会被叠两层。 */
QTreeView::item:selected {
    color: @text_primary;
}

QTreeView::item:selected:active {
    color: @text_primary;
}

QTreeView::item:selected:!active {
    color: @text_primary;
}

QTreeView::item:disabled {
    color: @text_disabled;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: none;
    border-image: none;
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: none;
    border-image: none;
}

QTreeView::branch {
    background-color: transparent;
}

QHeaderView::section {
    background-color: @primary_bg;
    color: @text_primary;
    padding: 8px;
    border: none;
    border-bottom: 1px solid @border;
    border-right: 1px solid @border;
}

QTableView {
    background-color: @tertiary_bg;
    alternate-background-color: @panel_alt;
    border: 1px solid @border;
    border-radius: 4px;
    color: @text_primary;
    gridline-color: @border;
    outline: 0;
}

QTableView::item {
    padding: 4px 6px;
}

QTableView::item:hover {
    background-color: @hover_bg;
}

QTableView::item:selected,
QTableView::item:selected:!active {
    background-color: @selected_bg;
    color: @text_primary;
}

QFrame#cardFrame {
    background-color: @tertiary_bg;
    border: 1px solid @border;
    border-radius: 4px;
}

QLabel#sectionTitle {
    color: @text_primary;
    font-size: 14px;
    font-weight: bold;
    padding: 0 8px;
}

QLabel#alarmCount {
    color: @error;
    font-size: 12px;
    padding: 0 8px;
}

QPushButton#primaryButton {
    background-color: @accent;
    color: @on_accent;
    border: 1px solid @accent;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 70px;
}

QPushButton#primaryButton:hover {
    background-color: @accent_hover;
    border-color: @accent_hover;
}

QPushButton#primaryButton:pressed {
    background-color: @accent_pressed;
    border-color: @accent_pressed;
}

QPushButton#primaryButton:disabled {
    background-color: @secondary_bg;
    border-color: @border;
    color: @text_disabled;
}

QToolTip {

    background-color: @primary_bg;
    color: @text_primary;
    border: 1px solid @border;
    padding: 4px;
    border-radius: 4px;
}

/* LoginWindow Styles */

#loginTitle {
    color: @accent;
    font-size: 42px;
    font-weight: bold;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    letter-spacing: 4px;
}

#loginSubtitle {
    color: @text_secondary;
    font-size: 14px;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    letter-spacing: 1px;
}

#loginVersion {
    color: @text_disabled;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
}

#rightPanel {
    background-color: @secondary_bg;
}

#welcomeLabel {
    color: @text_primary;
    font-size: 28px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
}

#descLabel {
    color: @text_secondary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    margin-bottom: 20px;
}

#formLabel {
    color: @text_secondary;
    font-size: 12px;
    font-family: 'Microsoft YaHei', sans-serif;
}

#serverHostEdit,
#usernameEdit,
#passwordEdit {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 0 12px;
    color: @text_primary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    min-height: 40px;
}

#serverHostEdit:focus,
#usernameEdit:focus,
#passwordEdit:focus {
    border-color: @accent;
    background-color: @primary_bg;
}

#serverHostEdit:disabled,
#usernameEdit:disabled,
#passwordEdit:disabled {
    background-color: @primary_bg;
    color: @text_secondary;
}

#serverPortSpin {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 0 12px;
    color: @text_primary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    min-height: 40px;
}

#serverPortSpin:focus {
    border-color: @accent;
    background-color: @primary_bg;
}

#serverPortSpin::up-button,
#serverPortSpin::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

#serverPortSpin::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid @text_secondary;
}

#serverPortSpin::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid @text_secondary;
}

#httpsCheck,
#rememberCheck {
    color: @text_secondary;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
}

#httpsCheck::indicator,
#rememberCheck::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid @border;
    background-color: @secondary_bg;
}

#httpsCheck::indicator:checked,
#rememberCheck::indicator:checked {
    background-color: @accent;
    border-color: @accent;
}

#httpsCheck:hover,
#rememberCheck:hover {
    color: @text_primary;
}

#errorLabel {
    color: @error;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
    background-color: @error_soft_bg;
    border: 1px solid @error_soft_border;
    border-radius: 4px;
    padding: 8px 12px;
}

#loginButton {
    background-color: @accent;
    color: @on_accent;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
    letter-spacing: 8px;
    min-height: 50px;
}

#loginButton:hover {
    background-color: @accent_hover;
}

#loginButton:pressed {
    background-color: @accent_pressed;
}

#loginButton:disabled {
    background-color: @border;
    color: @text_secondary;
}

#forgotLabel,
#serverConfigLink {
    color: @text_secondary;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
}

#forgotLabel a,
#serverConfigLink a {
    color: @text_secondary;
    text-decoration: none;
}

#forgotLabel a:hover,
#serverConfigLink a:hover {
    color: @accent;
}

#copyrightLabel {
    color: @text_secondary;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
}

/* LiveVideo Styles */
rustcam--VideoCell {
    background-color: @cell_bg;
    border: 1px solid @cell_border;
    border-radius: 4px;
}

rustcam--VideoCell:hover {
    border: 1px solid @accent;
}

#VideoLabel {
    color: @cell_fg;
    font-size: 14px;
    background-color: @cell_bg;
}

#VideoOverlay {
    background-color: @overlay_bg;
}

#VideoOverlay #OverlayText {
    color: @cell_fg;
    font-size: 12px;
}

#OsdLabel {
    color: white;
    background-color: @osd_bg;
    padding: 4px 8px;
    border-radius: 2px;
    font-size: 11px;
}

#TitleLabel {
    color: white;
    background-color: @osd_bg;
    padding: 4px 8px;
    border-radius: 2px;
    font-size: 12px;
    font-weight: bold;
}

QToolBar#VideoToolbar {
    background-color: @primary_bg;
    border: none;
    spacing: 8px;
    padding: 4px;
}

QToolBar#VideoToolbar QLabel {
    color: @text_primary;
}

QToolBar#VideoToolbar QComboBox {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 8px;
    color: @text_primary;
}

#VideoPlayer {
    border: none;
    background-color: @video_area_bg;
}


#VideoPlayer #NoSignalIcon{
    background-color: transparent;
}

#VideoPlayerToolbar {
    background-color: @overlay_bg;
}

#VideoPlayerToolbar #ToolbarButton {
    background-color: transparent;
    border: none;
    padding: 4px;
    color: @overlay_text;
}

#VideoPlayerToolbar #ToolbarButton:hover {
    background-color: @overlay_hover;
    border-radius: 4px;
}

#VideoPlayerToolbar #ToolbarButton:pressed {
    background-color: @overlay_pressed;
    border-radius: 4px;
}

#VideoPlayerToolbar #ToolbarButton:checked {
    background-color: @accent;
    border-radius: 4px;
}

#VideoPlayerToolbar #VideoPlayerToolbarWidget {
    background-color: transparent;
}

#VideoPlayerToolbar QToolButton::menu-indicator {
    image: none;
}
#videoArea {
    background-color: @video_area_bg;
}

/* class 属性由 setProperty("class", "LayoutNavButton") 设置 */
.LayoutNavButton {
    border: 1px solid @border;
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @navbtn_bg1, stop:1 @navbtn_bg2);
}

.LayoutNavButton:hover {
    border: 1px solid @navbtn_border;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @navbtn_hover1, stop:1 @navbtn_hover2);
}

.LayoutNavButton:pressed {
    border: 1px solid @accent;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @accent, stop:1 @accent_pressed);
}

#navBar {
    background-color: @secondary_bg;
}

/* Settings Widget Styles */
QTabWidget#settingsTabs::pane {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 16px;
}

QTabWidget#settingsTabs QTabBar::tab {
    background-color: @primary_bg;
    color: @text_secondary;
    padding: 10px 20px;
    border: 1px solid @border;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
}

QTabWidget#settingsTabs QTabBar::tab:selected {
    background-color: @secondary_bg;
    color: @text_primary;
    border-color: @border;
    border-bottom: 1px solid @secondary_bg;
}

QTabWidget#settingsTabs QTabBar::tab:hover {
    background-color: @hover_bg;
}

QCheckBox {
    color: @text_primary;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid @border;
    background-color: @primary_bg;
}

QCheckBox::indicator:checked {
    background-color: @accent;
    border-color: @accent;
    image: url(:/icons/check.svg);
}

QCheckBox::indicator:unchecked:hover {
    border-color: @accent;
}

QSpinBox {
    background-color: @primary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px;
    color: @text_primary;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
}

QSpinBox:focus {
    border-color: @accent;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: @secondary_bg;
    border: none;
    width: 20px;
    border-radius: 2px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: @accent;
}

QSpinBox::up-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid @text_primary;
}

QSpinBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid @text_primary;
}

QListWidget {
    background-color: @primary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    color: @text_primary;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    padding: 4px;
}

QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
    background-color: transparent;
}

QListWidget::item:hover {
    background-color: @hover_bg;
}

QListWidget::item:selected {
    background-color: @selected_bg;
    color: @text_primary;
}

QGroupBox {
    border: 1px solid @border;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 12px;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    color: @text_primary;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    color: @text_primary;
}

#colorPreviewLabel {
    border: 1px solid @border;
    border-radius: 4px;
    min-width: 60px;
    min-height: 24px;
    background-color: @primary_bg;
}

SettingsWidget QLabel {
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
}

/* ── Playback / Recording ──────────────────────────────────────── */

#playbackWorkspace,
#playbackRightPanel,
#PlaybackSidePanel {
    background-color: @primary_bg;
}

#playbackWorkspace QLabel {
    color: @text_primary;
}

#playbackToolbar {
    background-color: @primary_bg;
    border: none;
    border-bottom: 1px solid @border;
    spacing: 8px;
    padding: 4px;
}

QLabel#PlaybackSectionTitle {
    color: @text_primary;
    font-weight: bold;
    padding: 4px;
}

QLabel#PlaybackPanelLabel {
    color: @text_primary;
}

QLabel#PlaybackTargetLabel {
    color: @text_secondary;
}

QLabel#currentTimeLabel {
    color: @text_primary;
    font-family: monospace;
    min-width: 150px;
}

#PlaybackFilterFrame,
#PlaybackFileListFrame {
    border: 1px solid @border;
    border-radius: 4px;
}

#PlaybackFilterScroll {
    background-color: @primary_bg;
    border: none;
}

#PlaybackFilterScroll > QWidget > QWidget {
    background-color: @primary_bg;
}

QDateEdit#PlaybackFilterInput,
QDateTimeEdit#PlaybackFilterInput {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px;
    color: @text_primary;
}

QDateEdit#PlaybackFilterInput:focus,
QDateTimeEdit#PlaybackFilterInput:focus {
    border-color: @accent;
}

QDateTimeEdit#PlaybackFilterInput {
    font-size: 11px;
}

QLabel#PlaybackFilterFieldLabel {
    color: @text_secondary;
}

QLabel#PlaybackStatusLabel {
    color: @text_secondary;
    font-size: 11px;
    padding: 0 4px;
}

QPushButton#LoadMoreButton {
    background-color: @secondary_bg;
    color: @text_primary;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px;
}

QPushButton#LoadMoreButton:hover {
    background-color: @hover_bg;
}

QPushButton#LoadMoreButton:disabled {
    color: @text_disabled;
}

QListWidget#PlaybackBookmarkList {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    color: @text_primary;
    font-size: 12px;
}

QListWidget#PlaybackBookmarkList::item:selected {
    background-color: @selected_bg_active;
    color: @text_primary;
}

QLabel#RecordingCountLabel {
    color: @text_secondary;
    font-size: 12px;
    padding: 2px;
}

QComboBox#RecordingPageSizeCombo {
    font-size: 12px;
}

#RecordingFileListView {
    background-color: @secondary_bg;
    border: none;
    outline: none;
}

#RecordingFileListView::item {
    padding: 4px;
    border-bottom: 1px solid @border;
    color: @text_primary;
}

#RecordingFileListView::item:hover {
    background-color: @hover_bg;
}

#RecordingFileListView::item:selected {
    background-color: @selected_bg;
    color: @text_primary;
}

#TimelineWidget {
    background-color: @tertiary_bg;
    border: 1px solid @border;
}

#PlaybackCell {
    border: 2px solid @video_area_bg;
    background-color: @video_area_bg;
}

#PlaybackCell[selected="true"] {
    border-color: @accent;
}
#NoRecordingLabel {
    color: @text_primary;
    font-size: 14px;
    background-color: @overlay_bg;
    border-radius: 4px;
    padding: 8px 16px;
}
/* 日期选择下拉日历 */
QCalendarWidget {
    background-color: @secondary_bg;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: @primary_bg;
    border-bottom: 1px solid @border;
}

QCalendarWidget QToolButton {
    color: @text_primary;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: @hover_bg;
}


QCalendarWidget QMenu {
    background-color: @secondary_bg;
    color: @text_primary;
    border: 1px solid @border;
}

QCalendarWidget QMenu::item:selected {
    background-color: @accent;
    color: @on_accent;
}

QCalendarWidget QSpinBox {
    background-color: @secondary_bg;
    color: @text_primary;
    border: 1px solid @border;
    selection-background-color: @accent;
    selection-color: @on_accent;
}

QCalendarWidget QAbstractItemView {
    background-color: @secondary_bg;
    color: @text_primary;
    selection-background-color: @accent;
    selection-color: @on_accent;
    outline: none;
}

QCalendarWidget QHeaderView::section {
    background-color: @primary_bg;
    color: @text_secondary;
    padding: 2px;
    border: none;
}

/* ── 设备树容器 ────────────────────────────────────────────────────
 * DeviceTree 本身是透明容器，底色由外层的 tab pane 决定；
 * 这里显式给一层 @secondary_bg，保证树视图的"凹陷"效果在三个主题一致。
 */
#deviceTree {
    background-color: @secondary_bg;
}

/* ── 实时视频 ────────────────────────────────────────────────────── */
#LiveVideoWorkspace {
    background-color: @secondary_bg;
}

#sidePanel,
#VideoSidePanel {
    background-color: @secondary_bg;
    border-right: 1px solid @border;
}

#VideoPlayerWrapper {
    border: 2px solid @tertiary_bg;
    background-color: @tertiary_bg;
}

#VideoPlayerWrapper[selected="true"] {
    border: 2px solid @accent;
}

#StatusLabel {
    background-color: @overlay_bg;
    color: @overlay_text;
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 13px;
}

#ErrorLabel {
    background-color: @error_overlay_bg;
    color: @overlay_text;
    padding: 12px 20px;
    border-radius: 4px;
    font-size: 13px;
}

/* ── 电子地图 ────────────────────────────────────────────────────── */
#mapToolbar {
    background-color: @primary_bg;
    border: none;
    spacing: 8px;
    padding: 4px;
}

#mapToolbar QLabel {
    color: @text_primary;
    font-size: 14px;
    font-weight: bold;
    padding: 0 8px;
}

/* class 属性由 setProperty("class", "mapToolButton") 设置 */
.mapToolButton {
    background-color: @secondary_bg;
    color: @text_primary;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 12px;
}

.mapToolButton:hover {
    background-color: @hover_bg;
    border-color: @accent;
}

#mapSidePanel {
    background-color: @secondary_bg;
}

QTabWidget#mapTabs::pane {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 4px;
}

QTabWidget#mapTabs QTabBar::tab {
    background-color: @primary_bg;
    color: @text_secondary;
    padding: 6px 12px;
    border: 1px solid @border;
    border-bottom: none;
}

QTabWidget#mapTabs QTabBar::tab:selected {
    background-color: @secondary_bg;
    color: @text_primary;
}

QTabWidget#mapTabs QTabBar::tab:hover {
    background-color: @hover_bg;
}

#mapContainer {
    background-color: @tertiary_bg;
    border: 1px solid @border;
}

#mapSearchEdit {
    background-color: @tertiary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 8px 12px;
    color: @text_primary;
}

#mapSearchEdit:focus {
    border-color: @accent;
}

#mapDeviceList {
    background-color: @tertiary_bg;
    border: 1px solid @border;
    border-radius: 4px;
    color: @text_primary;
}

#mapDeviceList::item {
    padding: 8px;
    border-bottom: 1px solid @border;
}

#mapDeviceList::item:selected {
    background-color: @selected_bg;
}

#mapPlayerDialog {
    background-color: @tertiary_bg;
}

/* ── 服务器配置对话框 ────────────────────────────────────────────── */
#serverConfigDialog {
    background-color: @primary_bg;
}

#serverConfigTitle {
    color: @text_primary;
    font-size: 18px;
    font-weight: bold;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
}

#serverConfigDesc {
    color: @text_secondary;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
}

#serverConfigForm {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 8px;
}

#serverConfigFormLabel {
    color: @text_primary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
}

#serverConfigHostEdit,
#serverConfigPortSpin {
    background-color: @secondary_bg;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 0 12px;
    color: @text_primary;
    font-size: 14px;
    font-family: 'Microsoft YaHei', sans-serif;
    min-height: 40px;
}

#serverConfigHostEdit:focus,
#serverConfigPortSpin:focus {
    border-color: @accent;
}

#serverConfigHostEdit:disabled,
#serverConfigPortSpin:disabled {
    background-color: @primary_bg;
    color: @text_secondary;
}

#serverConfigHttpsCheck {
    color: @text_secondary;
    font-size: 13px;
    font-family: 'Microsoft YaHei', sans-serif;
}

#serverConfigStatus {
    color: @text_secondary;
    font-size: 13px;
}

#serverConfigTestButton,
#serverConfigCancelButton {
    background-color: @secondary_bg;
    color: @text_primary;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 70px;
}

#serverConfigTestButton:hover,
#serverConfigCancelButton:hover {
    background-color: @hover_bg;
    border-color: @accent;
    color: @text_primary;
}

#serverConfigSaveButton {
    background-color: @accent;
    color: @on_accent;
    border: 1px solid @accent;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 70px;
}

#serverConfigSaveButton:hover {
    background-color: @accent_hover;
    border-color: @accent_hover;
}

#serverConfigSaveButton:pressed {
    background-color: @accent_pressed;
    border-color: @accent_pressed;
}

/* ── 片段导出 / 设置页 / 连接状态 ────────────────────────────────── */
#clipExportInfo {
    color: @text_secondary;
}

#clipExportStatus {
    color: @text_secondary;
}

#settingsHintLabel {
    color: @text_secondary;
    font-size: 11px;
}

#statusConnection {
    color: @text_secondary;
}
