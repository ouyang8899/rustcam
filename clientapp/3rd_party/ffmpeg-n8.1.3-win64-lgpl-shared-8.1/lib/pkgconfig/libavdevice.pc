prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 62.3.103
Requires: 
Requires.private: libavfilter >= 11.14.103, libswscale >= 9.5.103, libavformat >= 62.12.103, libavcodec >= 62.28.103, libswresample >= 6.3.103, libavutil >= 60.26.103
Conflicts:
Libs: -L${libdir}  -lavdevice 
Cflags: -I${includedir}
